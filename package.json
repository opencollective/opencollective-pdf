{
  "name": "opencollective-pdf",
  "version": "2.0.0",
  "description": "PDF generation service for Open Collective",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsx scripts/update-cloudflare-ips.ts dist/server/cloudflare-ips.json",
    "start": "node --import ./dist/instrument.js dist/server/index.js",
    "test": "START_SERVER=false vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage --reporter=junit --reporter=default --outputFile=test-report.junit.xml",
    "test:update": "rm test/__snapshots__/*.png && vitest --run",
    "type:check": "tsc --noEmit",
    "dev": "tsx --import ./instrument.ts watch server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "depcheck": "npx depcheck --ignores='server,@graphql-typed-document-node/core,@vitest/coverage-v8'",
    "script": "tsx $@",
    "graphql:update": "npm-run-all graphql:updateV1 graphql:updateV2 graphql:codegen",
    "graphql:codegen": "graphql-codegen --config scripts/config/graphql-codegen.ts && prettier server/graphql/types --write",
    "graphql:updateV1": "tsx ./scripts/update-gql-schemas.js http://localhost:3060/graphql/v1 server/graphql/schema.graphql && prettier server/graphql/schema.graphql --write",
    "graphql:updateV2": "tsx ./scripts/update-gql-schemas.js http://localhost:3060/graphql/v2 server/graphql/schemaV2.graphql && prettier server/graphql/schemaV2.graphql --write"
  },
  "dependencies": {
    "@ag-media/react-pdf-table": "^2.0.3",
    "@apollo/client": "3.14.1",
    "@hyperwatch/hyperwatch": "5.3.1",
    "@opencollective/taxes": "5.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/node": "11.4.0",
    "@sentry/profiling-node": "11.4.0",
    "dayjs": "1.11.23",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "express-rate-limit": "8.7.1",
    "i18n-iso-countries": "7.14.0",
    "lodash-es": "4.18.1",
    "pdf-fontkit": "1.8.9",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.5",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^8.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "graphql": "^16.14.2",
    "nock": "^14.0.17",
    "node-fetch": "^3.3.2",
    "npm-run-all2": "^9.0.3",
    "pdf-visual-diff": "^0.16.0",
    "prettier": "3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@unicode/unicode-17.0.0": "2.0.7"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
