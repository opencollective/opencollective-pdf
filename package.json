{
  "name": "opencollective-pdf",
  "version": "2.0.0",
  "description": "PDF generation service for Open Collective",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run turbo -- run build:finalize",
    "start": "node --import ./dist/instrument.js dist/server/index.js",
    "test": "npm run turbo -- run test:task --",
    "test:watch": "npm run turbo -- run test:watch:task --",
    "test:coverage": "npm run turbo -- run test:coverage:task --",
    "test:update": "npm run turbo -- run test:update:task --",
    "type:check": "npm run turbo -- run type:check:task --",
    "dev": "npm run turbo -- run dev:task --",
    "lint": "npm run turbo -- run lint:task --",
    "lint:fix": "npm run turbo -- run lint:fix:task --",
    "prettier": "npm run turbo -- run prettier:task --",
    "prettier:check": "npm run turbo -- run prettier:check:task --",
    "depcheck": "npm run turbo -- run depcheck:task --",
    "script": "tsx $@",
    "graphql:update": "npm run turbo -- run graphql:refresh",
    "graphql:codegen": "graphql-codegen --config scripts/config/graphql-codegen.ts && prettier server/graphql/types --write",
    "graphql:updateV1": "tsx ./scripts/update-gql-schemas.js http://localhost:3060/graphql/v1 server/graphql/schema.graphql && prettier server/graphql/schema.graphql --write",
    "graphql:updateV2": "tsx ./scripts/update-gql-schemas.js http://localhost:3060/graphql/v2 server/graphql/schemaV2.graphql && prettier server/graphql/schemaV2.graphql --write",
    "format:check": "npm run turbo -- run format:check:task --",
    "format": "npm run turbo -- run format:task --",
    "build:compile": "tsc",
    "build:updates": "tsx scripts/update-cloudflare-ips.ts dist/server/cloudflare-ips.json",
    "build:finalize": "npm run build:updates",
    "graphql:refresh": "npm run graphql:codegen",
    "dev:environment": "npm run dev:task -- \"$OC_DEV_ENV_PDF\"",
    "start:built": "node --import ./dist/instrument.js dist/server/index.js",
    "turbo": "turbo --skip-infer --single-package --root-turbo-json=turbo.standalone.json",
    "build:clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "test:task": "START_SERVER=false vitest --run",
    "test:watch:task": "vitest --watch",
    "test:coverage:task": "vitest --run --coverage --reporter=junit --reporter=default --outputFile=test-report.junit.xml",
    "test:update:task": "rm test/__snapshots__/*.png && vitest --run",
    "type:check:task": "tsc --noEmit",
    "dev:task": "tsx --import ./instrument.ts watch server/index.ts",
    "lint:task": "eslint .",
    "lint:fix:task": "eslint . --fix",
    "prettier:task": "prettier --write .",
    "prettier:check:task": "prettier --check .",
    "depcheck:task": "npx depcheck --ignores='server,@graphql-typed-document-node/core,@vitest/coverage-v8'",
    "format:check:task": "npm run prettier:check:task",
    "format:task": "npm run prettier:task"
  },
  "dependencies": {
    "@ag-media/react-pdf-table": "^2.0.3",
    "@apollo/client": "3.14.1",
    "@hyperwatch/hyperwatch": "5.3.3",
    "@opencollective/taxes": "5.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/node": "11.8.0",
    "@sentry/profiling-node": "11.8.0",
    "dayjs": "1.11.23",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-basic-auth": "1.2.1",
    "express-rate-limit": "8.7.1",
    "i18n-iso-countries": "7.14.0",
    "lodash-es": "4.18.1",
    "pdf-fontkit": "1.8.9",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.5",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^8.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "graphql": "^16.14.2",
    "nock": "^15.0.0",
    "node-fetch": "^3.3.2",
    "pdf-visual-diff": "^0.16.0",
    "prettier": "3.9.10",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "turbo": "2.11.7"
  },
  "overrides": {
    "@unicode/unicode-17.0.0": "2.0.8"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0"
}
